{
  "name": "vscode-ulid-generator",
  "displayName": "ULID Generator",
  "description": "An extension to generate Universally Unique Lexicographically Sortable Identifiers, known as ULID",
  "version": "1.1.0",
  "keywords": [
    "ULID"
  ],
  "categories": [
    "Other"
  ],
  "license": "MIT",
  "icon": "images/icon.png",
  "publisher": "motivesoft",
  "author": {
    "name": "ianabrown",
    "url": "https://github.com/ianabrown"
  },
  "homepage": "https://github.com/Motivesoft/vscode-ulid-generator/blob/master/README.md",
  "repository": {
    "type": "git",
    "url": "https://github.com/Motivesoft/vscode-ulid-generator.git"
  },
  "bugs": {
    "url": "https://github.com/Motivesoft/vscode-ulid-generator/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "main": "./out/extension.js",
  "browser": "./dist/web/extension.js",
  "scripts": {
    "vscode:prepublish": "npm run compile && npm run compile-web",
    "compile": "tsc -p ./",
    "watch": "tsc -w -p ./",
    "pretest": "npm run compile",
    "test": "node ./out/test/runTest.js",

    "compile-web": "webpack",
    "watch-web": "webpack --watch",
    "test-web": "npm run compile-web && npx vscode-test-web --extensionDevelopmentPath=./"
  },
  "contributes": {
    "commands": [
      {
        "command": "vscode-ulid-generator.helloWorld",
        "title": "Hello World"
      }
    ]
  },
  "activationEvents": [
    "onCommand:vscode-ulid-generator.helloWorld"
  ],
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-web": "^0.0.80",
    "ts-loader": "^9.5.7",
    "typescript": "^5.2.0",
    "webpack": "^5.106.2",
    "webpack-cli": "^5.1.4"
  }
}
